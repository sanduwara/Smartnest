{
  "status": {
    "method": "GET",
    "endpoint": "/api/status"
  },
  "light": {
    "method": "POST",
    "endpoint": "/api/light",
    "examples": [
      { "name": "bedroom1", "state": true, "manual": true },
      { "name": "bedroom2", "state": false },
      { "name": "living1", "state": true },
      { "name": "living2", "state": false },
      { "name": "kitchen", "state": true }
    ]
  },
  "livingAll": {
    "method": "POST",
    "endpoint": "/api/living-all",
    "examples": [
      { "state": true },
      { "state": false }
    ]
  },
  "bedroom1Mode": {
    "method": "POST",
    "endpoint": "/api/bedroom1-mode",
    "examples": [
      { "mode": "AUTO" },
      { "mode": "MANUAL" }
    ]
  },
  "bedroom1Ac": {
    "method": "POST",
    "endpoint": "/api/bedroom1-ac",
    "examples": [
      { "mode": "AUTO" },
      { "state": true },
      { "state": false }
    ]
  },
  "door": {
    "method": "POST",
    "endpoint": "/api/door",
    "examples": [
      { "state": "lock" },
      { "state": "unlock" }
    ]
  },
  "garage": {
    "method": "POST",
    "endpoint": "/api/garage",
    "examples": [
      { "state": "open" },
      { "state": "close" },
      { "state": "toggle" }
    ]
  }
}
